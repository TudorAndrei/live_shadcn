amends "package://github.com/jdx/hk/releases/download/v1.56.1/hk@1.56.1#/Config.pkl"
import "package://github.com/jdx/hk/releases/download/v1.56.1/hk@1.56.1#/Builtins.pkl"

local linters = new Mapping<String, Step | Group> {
    // ── tier 1: gatekeepers. They never change a file. ──
    ["check-merge-conflict"] = Builtins.check_merge_conflict
    ["check-added-large-files"] = Builtins.check_added_large_files
    ["detect-private-key"] = Builtins.detect_private_key
    ["gitleaks"] = Builtins.gitleaks
    ["actionlint"] = (Builtins.actionlint) { depends = List("pinact") }
    ["zizmor"] = (Builtins.zizmor) { depends = List("pinact") }

    // ── tier 2: content fixers. `typos` reads every file, so it takes the barrier. ──
    ["typos"] = (Builtins.typos) { exclusive = true }
    // Pins every action to a commit SHA. `zizmor` reads what this writes.
    ["pinact"] = Builtins.pinact
    // docs/INVENTORY.md is generated by `mix ui.status`, which compares it byte
    // for byte in CI. A formatter must not touch it.
    ["rumdl"] = (Builtins.rumdl) { exclude = List("docs/INVENTORY.md") }

    // ── tier 3: formatters. Each one waits for the fixer that shares its files. ──
    // `mix format` resolves `import_deps` against the project it runs in, so each
    // mix.exs directory gets its own run instead of one run from the repo root.
    ["mix-format"] = (Builtins.mix_fmt) {
        workspace_indicator = "mix.exs"
        check = (Builtins.mix_fmt.check) {
            command = "cd {{workspace}} && mix format --check-formatted {{workspace_files}}"
        }
        fix = (Builtins.mix_fmt.fix) {
            command = "cd {{workspace}} && mix format {{workspace_files}}"
        }
    }
    ["rumdl-format"] = (Builtins.rumdl_format) {
        depends = List("rumdl")
        exclude = List("docs/INVENTORY.md")
    }
    ["tombi-format"] = Builtins.tombi_format

    // ── tier 4: whole-repo hygiene. One barrier for both steps. ──
    ["hygiene"] = new Group {
        steps {
            ["trailing-whitespace"] = Builtins.trailing_whitespace
            ["newlines"] = Builtins.newlines
        }
    }

    // ── tier 5: validators. They read the final bytes. ──
    ["tombi"] = Builtins.tombi
}

hooks {
    ["pre-commit"] {
        fix = true
        stash = "git"
        steps { ...linters }
    }
    ["commit-msg"] {
        steps {
            ["conventional-commit"] = Builtins.check_conventional_commit
        }
    }
    ["check"] { steps { ...linters } }
    ["fix"] { fix = true; steps { ...linters } }
}
