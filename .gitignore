# Elixir
_build/
deps/
# Dialyzer's persistent lookup tables. Minutes to build, megabytes on disk, and
# derived entirely from the dependencies — so CI caches them rather than
# committing them. `**/` because a pattern holding a slash is anchored to this
# file's directory, and the tables live one level down in every project.
**/priv/plts/
*.ez
*.beam
.elixir_ls/
.lexical/
erl_crash.dump
cover/

# Fetched upstream sources (regenerate with `mix ui.fetch`)
registry/upstream/**
!registry/upstream/.gitkeep

# Node
node_modules/

# Secrets. `DEFERRED.md` asks for a HEX_API_KEY and a Cloudflare token, and the
# obvious place to keep them while working is a file like this one. It is
# ignored so that a `git add -A` cannot commit it.
.env
.env.*
!.env.example

# OS
.DS_Store
node_modules/

# Built hex packages
*.tar
doc/

# Unpacked hex packages inspected by hand
tools/pkg/

# Playwright run artifacts
storybook/test/browser/test-results/
storybook/test/browser/playwright-report/

# Cloudflare deployment: generated types and the local wrangler state
storybook/deploy/node_modules/
storybook/deploy/worker-configuration.d.ts
storybook/deploy/.wrangler/
parity/.upstream/
