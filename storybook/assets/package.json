{
  "name": "live_shadcn_storybook",
  "private": true,
  "type": "module",
  "description": "Asset build for the live_shadcn demo application.",
  "scripts": {
    "build": "npm run upstream && npm run build:css && npm run build:js",
    "deploy": "npm run upstream && npm run build:css -- --minify && npm run build:js -- --minify",
    "upstream": "node upstream.mjs",
    "build:css": "tailwindcss --input=css/app.css --output=../priv/static/assets/app.css",
    "build:js": "rolldown -c rolldown.config.mjs"
  },
  "dependencies": {
    "@floating-ui/dom": "^1.8.0",
    "@rive-app/webgl2": "2.34.1",
    "live_ai_elements": "file:../../packages/live_ai_elements",
    "live_base": "file:../../packages/live_base",
    "media-chrome": "^4.19.2",
    "phoenix": "file:../deps/phoenix",
    "phoenix_html": "file:../deps/phoenix_html",
    "phoenix_live_view": "file:../deps/phoenix_live_view",
    "shadcn": "^4.19.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.0",
    "rolldown": "^1.2.5",
    "tailwindcss": "^4.3.0"
  },
  "allowScripts": {
    "@parcel/watcher@2.5.1": true
  }
}
