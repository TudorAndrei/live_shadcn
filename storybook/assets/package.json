{
  "name": "live_shadcn_storybook",
  "private": true,
  "type": "module",
  "description": "Asset build for the live_shadcn demo application.",
  "scripts": {
    "build": "npm run upstream && npm run build:css && npm run build:storybook:css && npm run build:js",
    "deploy": "npm run upstream && npm run build:css -- --minify && npm run build:storybook:css -- --minify && npm run build:js -- --minify",
    "upstream": "node upstream.mjs",
    "build:css": "tailwindcss --input=css/app.css --output=../priv/static/assets/app.css",
    "build:storybook:css": "tailwindcss --input=css/storybook.css --output=../priv/static/assets/storybook.css",
    "build:js": "esbuild js/app.js js/storybook.js --bundle --target=es2022 --outdir=../priv/static/assets --loader:.woff2=file --loader:.svg=file"
  },
  "dependencies": {
    "@floating-ui/dom": "^1.8.0",
    "live_base": "file:../../packages/live_base",
    "phoenix": "file:../deps/phoenix",
    "phoenix_html": "file:../deps/phoenix_html",
    "phoenix_live_view": "file:../deps/phoenix_live_view",
    "shadcn": "^4.19.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.0",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.3.0"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "@parcel/watcher@2.5.1": true
  }
}
